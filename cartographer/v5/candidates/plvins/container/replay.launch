<launch>
  <arg name="config" default="/data/plvins.yaml"/>
  <param name="use_sim_time" value="true"/>
  <node name="feature_tracker" pkg="feature_tracker" type="feature_tracker" required="true" output="screen">
    <param name="config_file" value="$(arg config)"/>
    <param name="vins_folder" value="/data"/>
  </node>
  <node name="linefeature_tracker" pkg="feature_tracker" type="LineFeature_tracker" required="true" output="screen">
    <param name="config_file" value="$(arg config)"/>
    <param name="vins_folder" value="/data"/>
  </node>
  <node name="plvins_estimator" pkg="plvins_estimator" type="plvins_estimator" required="true" output="screen">
    <param name="config_file" value="$(arg config)"/>
    <param name="vins_folder" value="/data"/>
  </node>
</launch>
