+  namespace {
+  void validatePoints(const Eigen::MatrixXd& points, int order) {
+    bounded::check();
+    bounded::require(order == 3 && points.rows() == 3 && points.cols() > 2 * order &&
+                     points.cols() <= static_cast<int>(bounded::kMaxControlPoints) && points.allFinite(),
+                     "invalid cubic control points");
+  }
+  // Derivative control hull bounds speed even for a returning/closed curve.
+  // Endpoint chord length does not: it is zero for a closed curve.
+  std::size_t collisionIntervals(UniformBspline& traj, double resolution, double& tm, double& end) {
+    bounded::require(traj.getTimeSpan(tm, end) && std::isfinite(tm) &&
+                     std::isfinite(end) && end > tm && bounded::positive(resolution),
+                     "invalid collision sampling span");
+    const auto derivative = traj.getDerivative().getControlPoint();
+    bounded::require(derivative.allFinite(), "non-finite trajectory derivative");
+    const double speed = derivative.colwise().norm().maxCoeff();
+    return bounded::intervals((end - tm) * speed, resolution * 0.5);
+  }
+  }
