+#ifndef EGO_BOUNDED_SAMPLING_H
+#define EGO_BOUNDED_SAMPLING_H
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstddef>
+#include <stdexcept>
+#include <vector>
+
+namespace ego_planner { namespace bounded {
+class Failure : public std::runtime_error {
+ public:
+  explicit Failure(const char* message) : std::runtime_error(message) {}
+};
+inline void require(bool condition, const char* message) {
+  if (!condition) throw Failure(message);
+}
+inline bool positive(double x) { return std::isfinite(x) && x > 0.0; }
+constexpr std::size_t kMaxSamples = 4096;
+constexpr std::size_t kMaxControlPoints = 512;
+using Clock = std::chrono::steady_clock;
+inline thread_local Clock::time_point deadline = Clock::time_point::max();
+class Budget {
+  Clock::time_point previous_;
+ public:
+  explicit Budget(std::chrono::milliseconds limit) : previous_(deadline) {
+    deadline = std::min(deadline, Clock::now() + limit);
+  }
+  ~Budget() { deadline = previous_; }
+};
+inline bool expired() { return Clock::now() >= deadline; }
+inline double remainingSeconds() {
+  require(!expired(), "planning wall-time budget exhausted");
+  return std::chrono::duration<double>(deadline - Clock::now()).count();
+}
+inline void check() { require(!expired(), "planning wall-time budget exhausted"); }
+// Reject an excessive request instead of clamping and silently skipping collisions.
+inline std::size_t intervals(double length, double spacing,
+                             std::size_t maximum = kMaxSamples) {
+  require(std::isfinite(length) && length >= 0.0 && positive(spacing),
+          "invalid sampling length/spacing");
+  const double count = std::ceil(length / spacing);
+  require(std::isfinite(count) && count <= static_cast<double>(maximum),
+          "sampling work limit exceeded");
+  return std::max<std::size_t>(1, static_cast<std::size_t>(count));
+}
+// Arc table must correspond one-to-one to points. Repeated vertices are legal;
+// an empty, singleton, non-monotone or wholly stationary table is not a path.
+template <class Point>
+std::vector<Point> resampleArc(const std::vector<Point>& points,
+                             const std::vector<double>& arc, double spacing) {
+  require(points.size() == arc.size() && arc.size() >= 2,
+          "empty or singleton arc table");
+  require(arc.front() == 0.0 && positive(arc.back()), "zero/non-finite arc length");
+  for (std::size_t i = 1; i < arc.size(); ++i)
+    require(std::isfinite(arc[i]) && arc[i] >= arc[i - 1], "invalid arc table");
+  const std::size_t n = std::max<std::size_t>(6, intervals(arc.back(), spacing, kMaxControlPoints - 3));
+  require(n <= kMaxControlPoints - 3, "too many arc samples");
+  std::vector<Point> output;
+  output.reserve(n + 1);
+  std::size_t id = 0;
+  for (std::size_t k = 0; k < n; ++k) {
+    check();
+    const double s = arc.back() * (static_cast<double>(k) / n);
+    while (id + 1 < arc.size() && arc[id + 1] <= s) ++id;
+    require(id + 1 < arc.size() && arc[id + 1] > arc[id], "no positive arc segment");
+    const double alpha = (s - arc[id]) / (arc[id + 1] - arc[id]);
+    output.push_back((1.0 - alpha) * points[id] + alpha * points[id + 1]);
+  }
+  output.push_back(points.back());
+  return output;
+}
+// Caller checks this BEFORE dereferencing the updated A* path index.
+inline bool advanceIndex(int& index, double value, std::size_t size) {
+  require(std::isfinite(value), "non-finite A* intersection");
+  index += value >= 0.0 ? -1 : 1;
+  return index >= 0 && static_cast<std::size_t>(index) < size;
+}
+}}  // namespace ego_planner::bounded
+#endif
