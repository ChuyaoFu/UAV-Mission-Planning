+// Conservative full-body query: integral volume of occupied OR unobserved voxels.
+void GridMap::rebuildSafetyPrefix() {
+  safety_shape_ = mp_.map_voxel_num_ + Eigen::Vector3i::Ones();
+  const int nx=safety_shape_.x(), ny=safety_shape_.y(), nz=safety_shape_.z();
+  safety_prefix_.assign(nx*ny*nz,0);
+  auto at=[&](int x,int y,int z)->int& {return safety_prefix_[(x*ny+y)*nz+z];};
+  for(int x=1;x<nx;++x)for(int y=1;y<ny;++y)for(int z=1;z<nz;++z){
+    auto i=Eigen::Vector3i(x-1,y-1,z-1);double l=md_.occupancy_buffer_[toAddress(i)];
+    int blocked=(l < mp_.clamp_min_log_-1e-3 || l >= 0.);
+    at(x,y,z)=blocked+at(x-1,y,z)+at(x,y-1,z)+at(x,y,z-1)-at(x-1,y-1,z)-at(x-1,y,z-1)-at(x,y-1,z-1)+at(x-1,y-1,z-1);
+  }
+}
+bool GridMap::sweptKnownFree(const Eigen::Vector3d &pos) {
+  const auto extent=Eigen::Vector3d(mp_.obstacles_inflation_,mp_.obstacles_inflation_,vertical_inflation_);
+  return boxKnownFree(pos-extent,pos+extent);
+}
+bool GridMap::controlHullKnownFree(const Eigen::MatrixXd &points) {
+  const auto extent=Eigen::Vector3d(mp_.obstacles_inflation_,mp_.obstacles_inflation_,vertical_inflation_);
+  if(points.cols()<4 || !points.allFinite())return false;
+  for(int i=0;i+3<points.cols();++i){
+    // Every cubic B-spline span lies in its four-control-point convex hull.
+    const auto span=points.middleCols(i,4);
+    if(!boxKnownFree(span.rowwise().minCoeff()-extent,span.rowwise().maxCoeff()+extent))return false;
+  }
+  return true;
+}
+bool GridMap::boxKnownFree(const Eigen::Vector3d &lo,const Eigen::Vector3d &hi) {
+  if(safety_prefix_.empty())return false;
+  Eigen::Vector3i a,b;posToIndex(lo,a);posToIndex(hi,b);
+  if(!isInMap(a)||!isInMap(b))return false;
+  b+=Eigen::Vector3i::Ones();int ny=safety_shape_.y(),nz=safety_shape_.z();
+  auto at=[&](int x,int y,int z){return safety_prefix_[(x*ny+y)*nz+z];};
+  int sum=at(b.x(),b.y(),b.z())-at(a.x(),b.y(),b.z())-at(b.x(),a.y(),b.z())-at(b.x(),b.y(),a.z())+at(a.x(),a.y(),b.z())+at(a.x(),b.y(),a.z())+at(b.x(),a.y(),a.z())-at(a.x(),a.y(),a.z());
+  return sum==0;
+}
+void GridMap::publishKnowledge(){
+  if(!knowledge_pub_->get_subscription_count())return;
+  std_msgs::msg::Float64MultiArray meta;
+  meta.data={mp_.map_origin_.x(),mp_.map_origin_.y(),mp_.map_origin_.z(),mp_.resolution_,double(mp_.map_voxel_num_.x()),double(mp_.map_voxel_num_.y()),double(mp_.map_voxel_num_.z()),node_->now().seconds(),last_depth_stamp_};
+  knowledge_meta_pub_->publish(meta);
+  std_msgs::msg::Int8MultiArray data;data.data.resize(md_.occupancy_buffer_.size());
+  for(size_t i=0;i<data.data.size();++i){double l=md_.occupancy_buffer_[i];data.data[i]=launch_mask_[i]?-2:(l<mp_.clamp_min_log_-1e-3?-1:(l<0?0:(l>mp_.min_occupancy_log_?1:-1)));}
+  knowledge_pub_->publish(data);
+}
