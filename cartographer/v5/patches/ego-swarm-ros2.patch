+// Optional asynchronous evidence never delays or re-integrates the raw stream.
+// Channel zero is checked for provenance but is NOT inserted as another hit.
+void GridMap::freeEvidencePoseCallback(const sensor_msgs::msg::Image::ConstPtr &img,
+                                      const geometry_msgs::msg::PoseStamped::ConstPtr &pose){
+  ++pipeline_stats_.free_callbacks;
+  PipelineWallTimer pipeline_free_time(pipeline_stats_.last_free_callback_ms,pipeline_stats_.max_free_callback_ms);
+  if(!allow_geometric_free_rays_ || img->encoding!=sensor_msgs::image_encodings::TYPE_32FC2 || img->header.frame_id!="left_optical")return;
+  const double stamp=rclcpp::Time(img->header.stamp).seconds(),age=node_->now().seconds()-stamp;
+  if(age<-.02 || age>inferred_free_input_max_age_s_ || std::abs((rclcpp::Time(img->header.stamp)-rclcpp::Time(pose->header.stamp)).seconds())>.005)return;
+  if(img->width==0 || img->height==0 || img->width>1280 || img->height>800 || img->step<img->width*8 || img->data.size()<size_t(img->step)*img->height)return;
+  // Pending direct hits win before any conditional visibility is admitted.
+  if(md_.occ_need_update_)updateOccupancyCallback();
+  if(node_->now().seconds()-stamp>inferred_free_input_max_age_s_)return;
+  const Eigen::Vector3d origin(pose->pose.position.x,pose->pose.position.y,pose->pose.position.z);
+  const Eigen::Quaterniond q(pose->pose.orientation.w,pose->pose.orientation.x,pose->pose.orientation.y,pose->pose.orientation.z);
+  if(!origin.allFinite() || !isInMap(origin) || !q.coeffs().allFinite() || std::abs(q.norm()-1.)>.001)return;
+  const Eigen::Matrix3d rotation=q.toRotationMatrix();
+  const auto image=cv_bridge::toCvShare(img,img->encoding);
+  const auto deadline=std::chrono::steady_clock::now()+std::chrono::milliseconds(50);
+  const double reserve=std::sqrt(3.)*mp_.resolution_;
+  const int max_steps=int(std::ceil(3.*mp_.max_ray_length_/mp_.resolution_))+6;
+  RayCaster caster;Eigen::Vector3d voxel;
+  for(int v=mp_.depth_filter_margin_;v<int(img->height)-mp_.depth_filter_margin_;v+=mp_.skip_pixel_){
+    if(std::chrono::steady_clock::now()>=deadline)break;
+    for(int u=mp_.depth_filter_margin_;u<int(img->width)-mp_.depth_filter_margin_;u+=mp_.skip_pixel_){
+      const auto value=image->image.at<cv::Vec2f>(v,u);
+      const double depth=value[1];
+      if(!std::isnan(value[0]) || !std::isfinite(depth) || depth<mp_.depth_filter_mindist_ || depth>mp_.depth_filter_maxdist_)continue;
+      Eigen::Vector3d endpoint=origin+rotation*Eigen::Vector3d((u-mp_.cx_)*depth/mp_.fx_,(v-mp_.cy_)*depth/mp_.fy_,depth);
+      Eigen::Vector3d direction=endpoint-origin;double length=direction.norm();
+      if(!std::isfinite(length) || length<=reserve+mp_.min_ray_length_)continue;
+      endpoint=origin+direction*(std::min(length,mp_.max_ray_length_)-reserve)/length;
+      if(!isInMap(endpoint))endpoint=closetPointInMap(endpoint,origin);
+      Eigen::Vector3i terminal;posToIndex(endpoint,terminal);
+      caster.setInput(origin/mp_.resolution_,endpoint/mp_.resolution_);
+      int steps=0;
+      while(caster.step(voxel) && ++steps<=max_steps){
+        const Eigen::Vector3d center=(voxel+Eigen::Vector3d::Constant(.5))*mp_.resolution_;
+        Eigen::Vector3i index;posToIndex(center,index);
+        if(!isInMap(index))break;
+        const int address=toAddress(index);
+        if(md_.occupancy_buffer_[address]>=0. || md_.count_hit_[address]>0)break;
+        if(index!=terminal)inferred_free_stamp_[address]=std::max(inferred_free_stamp_[address],stamp);
+      }
+    }
+  }
+  // The next raw update publishes/rebuilds the map. Inference cannot make a
+  // missing raw stream look fresh or increment measured occupancy log odds.
+}
