diff --git a/src/planner/plan_env/include/plan_env/pipeline_stats.h b/src/planner/plan_env/include/plan_env/pipeline_stats.h
new file mode 100644
index 0000000..584f10f
--- /dev/null
+++ b/src/planner/plan_env/include/plan_env/pipeline_stats.h
@@ -0,0 +1,101 @@
+#ifndef PLAN_ENV_PIPELINE_STATS_H
+#define PLAN_ENV_PIPELINE_STATS_H
+#include <algorithm>
+#include <cstdint>
+#include <chrono>
+#include <iomanip>
+#include <sstream>
+#include <string>
+
+// Diagnostic state only. The current node uses one mutually exclusive executor
+// group. No extra image reader, image copy, input gate or map behavior is added.
+struct GridPipelineStats {
+  std::uint64_t depth_rx=0, pose_rx=0, sync_pairs=0;
+  std::uint64_t free_callbacks=0, vis_callbacks=0;
+  std::uint64_t sync_drop_depth_only=0, sync_drop_pose_only=0, sync_drop_other=0;
+  std::uint64_t reject_stamp=0, reject_stale=0, reject_future=0;
+  std::uint64_t reject_encoding=0, reject_size=0, reject_out_of_map=0;
+  std::uint64_t accepted=0, pending_overwrites=0, pending_canceled=0;
+  std::uint64_t updates_started=0, updates_completed=0;
+  std::uint64_t publish_calls=0, publish_skipped_no_knowledge_reader=0;
+  std::uint64_t metadata_published=0, knowledge_published=0;
+  std::int64_t last_depth_rx_ns=-1, last_pose_rx_ns=-1, last_sync_ns=-1;
+  std::int64_t last_accepted_ns=-1, last_updated_ns=-1;
+  std::int64_t pending_ns=-1;
+  bool pending=false;
+  double last_depth_rx_age_s=-1, max_depth_rx_age_s=0;
+  double last_sync_age_s=-1, max_sync_age_s=0;
+  double last_update_ms=0, max_update_ms=0, max_update_callback_gap_ms=0;
+
+  double last_metadata_depth_s=-1;
+  double last_free_callback_ms=0, max_free_callback_ms=0;
+  double last_vis_callback_ms=0, max_vis_callback_ms=0;
+  double last_depth_pose_callback_ms=0, max_depth_pose_callback_ms=0;
+
+  void depth(std::int64_t stamp,double age) {
+    ++depth_rx;last_depth_rx_ns=stamp;last_depth_rx_age_s=age;
+    max_depth_rx_age_s=std::max(max_depth_rx_age_s,age);
+  }
+  void pose(std::int64_t stamp) {++pose_rx;last_pose_rx_ns=stamp;}
+  void pair(std::int64_t stamp,double age) {
+    ++sync_pairs;last_sync_ns=stamp;last_sync_age_s=age;
+    max_sync_age_s=std::max(max_sync_age_s,age);
+  }
+  void syncDrop(bool image,bool pose) {
+    if(image && !pose)++sync_drop_depth_only;
+    else if(pose && !image)++sync_drop_pose_only;
+    else ++sync_drop_other;
+  }
+  void accept(std::int64_t stamp) {
+    ++accepted;if(pending)++pending_overwrites;
+    pending=true;pending_ns=stamp;last_accepted_ns=stamp;
+  }
+  void cancelPending() {
+    if(pending)++pending_canceled;
+    pending=false;pending_ns=-1;
+  }
+  void completed(double milliseconds) {
+    ++updates_completed;last_updated_ns=pending_ns;
+    pending=false;pending_ns=-1;
+    last_update_ms=milliseconds;max_update_ms=std::max(max_update_ms,milliseconds);
+  }
+  std::string json(double ros_now_s,std::size_t knowledge_readers,int pose_type,
+                   bool depth_reliable=false,int depth_queue_size=20) const {
+    std::ostringstream out;out<<std::setprecision(12)<<"{\"schema\":1";
+    auto field=[&](const char* key,auto value){out<<",\""<<key<<"\":"<<value;};
+    field("ros_now_s",ros_now_s);field("pose_type",pose_type);field("knowledge_readers",knowledge_readers);
+    field("depth_reliable",depth_reliable);field("depth_queue_size",depth_queue_size);
+#define PLAN_ENV_STAT(name) field(#name,name)
+    PLAN_ENV_STAT(depth_rx);PLAN_ENV_STAT(pose_rx);PLAN_ENV_STAT(sync_pairs);
+    PLAN_ENV_STAT(free_callbacks);PLAN_ENV_STAT(vis_callbacks);
+    PLAN_ENV_STAT(sync_drop_depth_only);PLAN_ENV_STAT(sync_drop_pose_only);PLAN_ENV_STAT(sync_drop_other);
+    PLAN_ENV_STAT(reject_stamp);PLAN_ENV_STAT(reject_stale);PLAN_ENV_STAT(reject_future);
+    PLAN_ENV_STAT(reject_encoding);PLAN_ENV_STAT(reject_size);PLAN_ENV_STAT(reject_out_of_map);
+    PLAN_ENV_STAT(accepted);PLAN_ENV_STAT(pending_overwrites);PLAN_ENV_STAT(pending_canceled);
+    PLAN_ENV_STAT(updates_started);PLAN_ENV_STAT(updates_completed);PLAN_ENV_STAT(pending);
+    PLAN_ENV_STAT(publish_calls);PLAN_ENV_STAT(publish_skipped_no_knowledge_reader);
+    PLAN_ENV_STAT(metadata_published);PLAN_ENV_STAT(knowledge_published);
+    PLAN_ENV_STAT(last_depth_rx_ns);PLAN_ENV_STAT(last_pose_rx_ns);PLAN_ENV_STAT(last_sync_ns);
+    PLAN_ENV_STAT(last_accepted_ns);PLAN_ENV_STAT(last_updated_ns);PLAN_ENV_STAT(last_metadata_depth_s);
+    PLAN_ENV_STAT(last_depth_rx_age_s);PLAN_ENV_STAT(max_depth_rx_age_s);
+    PLAN_ENV_STAT(last_sync_age_s);PLAN_ENV_STAT(max_sync_age_s);
+    PLAN_ENV_STAT(last_update_ms);PLAN_ENV_STAT(max_update_ms);PLAN_ENV_STAT(max_update_callback_gap_ms);
+    PLAN_ENV_STAT(last_free_callback_ms);PLAN_ENV_STAT(max_free_callback_ms);
+    PLAN_ENV_STAT(last_vis_callback_ms);PLAN_ENV_STAT(max_vis_callback_ms);
+    PLAN_ENV_STAT(last_depth_pose_callback_ms);PLAN_ENV_STAT(max_depth_pose_callback_ms);
+#undef PLAN_ENV_STAT
+    out<<"}";return out.str();
+  }
+};
+struct PipelineWallTimer {
+  using Clock=std::chrono::steady_clock;
+  double& last;
+  double& maximum;
+  Clock::time_point start=Clock::now();
+  PipelineWallTimer(double& last_value,double& maximum_value):last(last_value),maximum(maximum_value) {}
+  ~PipelineWallTimer() {
+    last=std::chrono::duration<double,std::milli>(Clock::now()-start).count();
+    maximum=std::max(maximum,last);
+  }
+};
+#endif
