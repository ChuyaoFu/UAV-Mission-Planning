+  // Read-only joint posterior, retaining cross-covariance and the original
+  // translation gauge. No state, prior, measurement or noise is changed.
+  // Camera-time clone keys remain filter doubles, not fabricated sensor stamps.
+  if (pub_joint_clones->get_subscription_count() > 0 && state->_clones_IMU.size() >= 2) {
+    const auto latest = std::prev(state->_clones_IMU.end());
+    const size_t count = std::min<size_t>(10, state->_clones_IMU.size() - 1);
+    auto first = latest;
+    std::advance(first, -static_cast<long>(count));
+    std_msgs::msg::Float64MultiArray packet;
+    packet.layout.data_offset = 3;
+    packet.layout.dim.resize(2);
+    packet.layout.dim[0].label = "joint_clones_schema1_pairs";
+    packet.layout.dim[0].size = count;
+    packet.layout.dim[0].stride = count * 160;
+    packet.layout.dim[1].label = "tC0,tC1,pG0,qJPL_GI0_xyzw,pG1,qJPL_GI1_xyzw,P12_rowmajor_thetaI0_pG0_thetaI1_pG1";
+    packet.layout.dim[1].size = 160;
+    packet.layout.dim[1].stride = 160;
+    packet.data = {1., static_cast<double>(count), t_ItoC};
+    packet.data.reserve(3 + count * 160);
+    for (auto previous = first; previous != latest; ++previous) {
+      packet.data.push_back(previous->first);
+      packet.data.push_back(latest->first);
+      for (const auto &pose : {previous->second, latest->second}) {
+        for (int i = 0; i < 3; ++i) packet.data.push_back(pose->pos()(i));
+        for (int i = 0; i < 4; ++i) packet.data.push_back(pose->quat()(i));
+      }
+      std::vector<std::shared_ptr<Type>> variables = {previous->second->q(), previous->second->p(), latest->second->q(), latest->second->p()};
+      const Eigen::MatrixXd joint = StateHelper::get_marginal_covariance(state, variables);
+      for (int r = 0; r < 12; ++r)
+        for (int c = 0; c < 12; ++c) packet.data.push_back(joint(r,c));
+    }
+    pub_joint_clones->publish(packet);
+  }
