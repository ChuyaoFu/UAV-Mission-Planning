      </visual>
      <collision name="oak_housing">
        <pose>-.015 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>.03 .095 .035</size>
          </box>
        </geometry>
      </collision>
      <sensor name="monitor_oak_housing" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact>
          <collision>oak_housing</collision>
        </contact>
      </sensor>
    </link>
    <joint name="vio_rig_joint" type="fixed">
      <parent>base_link</parent>
      <child>vio_rig</child>
    </joint>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>true</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>20</update_frequency>
    </plugin>
  </model>
</sdf>