Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 36; 45
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Metric grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 30
      Color: 100; 110; 120
    - Class: cartographer_rviz/SubmapsDisplay
      Name: ACTUAL Cartographer submaps
      Enabled: true
      High Resolution: true
      Low Resolution: false
      Submap query service: /submap_query
      Topic:
        Value: /submap_list
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Tracking frame: vio_imu
    - Class: rviz_default_plugins/Map
      Name: Cartographer occupancy projection
      Enabled: true
      Alpha: 0.65
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: LIVE matched depth points
      Enabled: true
      Topic:
        Value: /scan_matched_points2
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 2
    - Class: rviz_default_plugins/MarkerArray
      Name: SLAM optimized trajectory
      Enabled: true
      Topic:
        Value: /trajectory_node_list
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
    - Class: rviz_default_plugins/MarkerArray
      Name: Live aircraft and localization status
      Enabled: true
      Topic:
        Value: /carto/view_markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 16
      Pitch: 1.35
      Yaw: 3.14
      Focal Point:
        X: 0
        Y: 0
        Z: 0.3
      Target Frame: map
Window Geometry:
  Width: 1260
  Height: 1500
  X: 1280
  Y: 50
