diff --git a/cartographer/mapping/internal/constraints/stereo_loop_guard.h b/cartographer/mapping/internal/constraints/stereo_loop_guard.h
new file mode 100644
index 0000000..e893fd9
--- /dev/null
+++ b/cartographer/mapping/internal/constraints/stereo_loop_guard.h
@@ -0,0 +1,52 @@
+#ifndef CARTOGRAPHER_MAPPING_INTERNAL_CONSTRAINTS_STEREO_LOOP_GUARD_H_
+#define CARTOGRAPHER_MAPPING_INTERNAL_CONSTRAINTS_STEREO_LOOP_GUARD_H_
+#include <algorithm>
+#include <cmath>
+#include <vector>
+#include <Eigen/Eigenvalues>
+#include "cartographer/sensor/point_cloud.h"
+#include "cartographer/transform/rigid_transform.h"
+#include "cartographer/transform/transform.h"
+namespace cartographer { namespace mapping { namespace constraints {
+// Camera-only place recognition must observe three independent surface normals.
+// A floor or a corridor's parallel walls cannot establish a six-DoF loop.
+inline bool StereoLoopGeometryIsObservable(const sensor::PointCloud& cloud) {
+  if (cloud.size() < 60) return false;
+  Eigen::Matrix3d information = Eigen::Matrix3d::Zero();
+  int normals = 0;
+  const int stride = std::max(1, static_cast<int>(cloud.size()) / 96);
+  for (int i = 0; i < static_cast<int>(cloud.size()); i += stride) {
+    std::vector<std::pair<float, int>> neighbors;
+    for (int j = 0; j < static_cast<int>(cloud.size()); ++j) {
+      if (i != j) neighbors.emplace_back(
+          (cloud[i].position - cloud[j].position).squaredNorm(), j);
+    }
+    const int k = 8;
+    std::partial_sort(neighbors.begin(), neighbors.begin() + k, neighbors.end());
+    if (neighbors[k - 1].first > .16f) continue;
+    Eigen::Vector3d mean = Eigen::Vector3d::Zero();
+    for (int j = 0; j < k; ++j) mean += cloud[neighbors[j].second].position.cast<double>();
+    mean /= k;
+    Eigen::Matrix3d covariance = Eigen::Matrix3d::Zero();
+    for (int j = 0; j < k; ++j) {
+      const Eigen::Vector3d d = cloud[neighbors[j].second].position.cast<double>() - mean;
+      covariance += d * d.transpose();
+    }
+    Eigen::SelfAdjointEigenSolver<Eigen::Matrix3d> eig(covariance);
+    if (eig.eigenvalues()[2] < 1e-8 ||
+        eig.eigenvalues()[0] > .04 * eig.eigenvalues()[2] ||
+        eig.eigenvalues()[1] < .03 * eig.eigenvalues()[2]) continue;
+    const Eigen::Vector3d normal = eig.eigenvectors().col(0);
+    information += normal * normal.transpose();
+    ++normals;
+  }
+  if (normals < 20) return false;
+  Eigen::SelfAdjointEigenSolver<Eigen::Matrix3d> eig(information);
+  return eig.eigenvalues()[0] > .03 * eig.eigenvalues()[2];
+}
+inline bool StereoLoopInnovationIsBounded(const transform::Rigid3d& difference) {
+  return difference.translation().norm() <= .25 &&
+         transform::GetAngle(difference) <= .07;
+}
+}}}
+#endif
diff --git a/cartographer/mapping/internal/constraints/stereo_loop_guard_test.cc b/cartographer/mapping/internal/constraints/stereo_loop_guard_test.cc
new file mode 100644
index 0000000..e7b9663
--- /dev/null
+++ b/cartographer/mapping/internal/constraints/stereo_loop_guard_test.cc
@@ -0,0 +1,34 @@
+#include "cartographer/mapping/internal/constraints/stereo_loop_guard.h"
+#include "gtest/gtest.h"
+namespace cartographer { namespace mapping { namespace constraints {
+sensor::PointCloud Planes(int count) {
+  std::vector<sensor::RangefinderPoint> points;
+  for (int axis = 0; axis < count; ++axis)
+    for (int a = 0; a < 17; ++a)
+      for (int b = 0; b < 17; ++b) {
+        Eigen::Vector3f p = Eigen::Vector3f::Constant(-.8f);
+        p[(axis + 1) % 3] = -.8f + .1f * a;
+        p[(axis + 2) % 3] = -.8f + .1f * b;
+        points.push_back({p});
+      }
+  return sensor::PointCloud(points);
+}
+TEST(StereoLoopGuard, RejectsFloorOnlyDespitePerfectOccupancyMatch) {
+  EXPECT_FALSE(StereoLoopGeometryIsObservable(Planes(1)));
+}
+TEST(StereoLoopGuard, RejectsTwoPlanesWithUnobservableTranslation) {
+  EXPECT_FALSE(StereoLoopGeometryIsObservable(Planes(2)));
+}
+TEST(StereoLoopGuard, AcceptsThreeIndependentRoomPlanes) {
+  EXPECT_TRUE(StereoLoopGeometryIsObservable(Planes(3)));
+}
+TEST(StereoLoopGuard, RejectsSparseData) {
+  EXPECT_FALSE(StereoLoopGeometryIsObservable(sensor::PointCloud()));
+}
+TEST(StereoLoopGuard, BoundsRefinedPoseNotOnlyCoarseSearch) {
+  EXPECT_TRUE(StereoLoopInnovationIsBounded(transform::Rigid3d::Translation(Eigen::Vector3d(.1, 0., 0.))));
+  EXPECT_FALSE(StereoLoopInnovationIsBounded(transform::Rigid3d::Translation(Eigen::Vector3d(2.23, 0., 0.))));
+  EXPECT_FALSE(StereoLoopInnovationIsBounded(transform::Rigid3d::Rotation(Eigen::Quaterniond(Eigen::AngleAxisd(.413, Eigen::Vector3d::UnitZ())))));
+  EXPECT_FALSE(StereoLoopInnovationIsBounded(transform::Rigid3d::Translation(Eigen::Vector3d(.251, 0., 0.))));
+}
+}}}
