FROM ros:jazzy-ros-base
ENV DEBIAN_FRONTEND=noninteractive RUNS_IN_DOCKER=true
SHELL ["/bin/bash", "-c"]
COPY px4-setup /tmp/px4-setup
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv && \
    python3 -m venv --system-site-packages /opt/px4-venv && \
    printf 'numpy<2\npandas<3\n' > /tmp/px4-constraints.txt
ENV VIRTUAL_ENV=/opt/px4-venv PATH=/opt/px4-venv/bin:$PATH PIP_CONSTRAINT=/tmp/px4-constraints.txt
RUN bash /tmp/px4-setup/ubuntu.sh --no-nuttx && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-ros-gz ros-jazzy-rviz2 ros-jazzy-cv-bridge \
    ros-jazzy-image-transport ros-jazzy-tf2-geometry-msgs \
    ros-jazzy-rmw-cyclonedds-cpp python3-colcon-common-extensions \
    python3-scipy python3-matplotlib python3-opencv python3-psutil \
    libboost-all-dev libceres-dev libopencv-contrib-dev \
    mesa-utils libegl1 libgl1 libglx0 xvfb xauth tmux \
    && rm -rf /var/lib/apt/lists/*
ENV ROS_DOMAIN_ID=42 RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
WORKDIR /work
CMD ["sleep", "infinity"]
